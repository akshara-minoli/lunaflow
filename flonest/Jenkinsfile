pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        // The Jenkins container talks to the Docker daemon through the mounted
        // Unix socket.  Clear Docker-in-Docker TLS variables inherited from the
        // controller image; otherwise the Docker CLI looks for /certs/client.
        DOCKER_HOST = 'unix:///var/run/docker.sock'
        DOCKER_TLS_VERIFY = ''
        DOCKER_CERT_PATH = ''
        REGISTRY = 'ghcr.io'
        IMAGE_OWNER = 'akshara-minoli'
        SERVER_IMAGE = 'ghcr.io/akshara-minoli/flonest-server'
        CLIENT_IMAGE = 'ghcr.io/akshara-minoli/flonest-client'
        K8S_NAMESPACE = 'flonest'
    }

    stages {
        stage('Checkout') {
            steps {
                ws('flonest-clean') {
                    git branch: env.BRANCH_NAME ?: 'main', url: 'https://github.com/akshara-minoli/lunaflow.git'
                    echo "Building repository: https://github.com/akshara-minoli/lunaflow.git"
                }
            }
        }

        stage('CI') {
            stages {
                stage('Verify Docker access') {
                    steps {
                        ws('flonest-clean') {
                            dir('flonest') {
                                sh '''
                                    docker version
                                    docker run --rm hello-world
                                '''
                            }
                        }
                    }
                }

                // CI: install dependencies for the workspace, backend, and frontend.
                stage('Install') {
                    steps {
                        ws('flonest-clean') {
                            dir('flonest') {
                                sh '''
                                    docker run --rm \
                                      --user "$(id -u):$(id -g)" \
                                      --volumes-from "$HOSTNAME" \
                                      -w "$PWD" \
                                      node:20-alpine sh -lc "npm install && npm install --prefix server && npm install --prefix client"
                                '''
                            }
                        }
                    }
                }

                // CI: build the frontend with the production API base path.
                stage('Build Client') {
                    steps {
                        ws('flonest-clean') {
                            dir('flonest') {
                                sh '''
                                    docker run --rm \
                                      --user "$(id -u):$(id -g)" \
                                      --volumes-from "$HOSTNAME" \
                                      -w "$PWD" \
                                      -e VITE_API_URL=/api \
                                      node:20-alpine sh -lc "npm run build --prefix client"
                                '''
                            }
                        }
                    }
                }

                // CI: verify the backend app can load without booting the full server.
                stage('Verify Server') {
                    steps {
                        ws('flonest-clean') {
                            dir('flonest') {
                                sh '''
                                    docker run --rm \
                                      --user "$(id -u):$(id -g)" \
                                      --volumes-from "$HOSTNAME" \
                                      -w "$PWD" \
                                      node:20-alpine node -e "require('./server/app'); console.log('Server app loaded successfully')"
                                '''
                            }
                        }
                    }
                }
            }
        }

        // CD: build the deployable Docker images for the API and web app.
        stage('Build Docker Images') {
            steps {
                ws('flonest-clean') {
                    dir('flonest') {
                        sh 'docker build -t ${SERVER_IMAGE}:${GIT_COMMIT} server'
                        sh 'docker build --build-arg VITE_API_URL=/api -t ${CLIENT_IMAGE}:${GIT_COMMIT} client'
                    }
                }
            }
        }

        // CD: publish images to GHCR on the main deployment branches.
        stage('Push Docker Images') {
            when {
                expression { env.BRANCH_NAME in ['main', 'master'] || env.GIT_BRANCH in ['main', 'master', 'origin/main', 'origin/master'] }
            }
            steps {
                withCredentials([string(credentialsId: 'ghcr-token', variable: 'GHCR_TOKEN')]) {
                    ws('flonest-clean') {
                        sh '''
                            echo "$GHCR_TOKEN" | docker login ${REGISTRY} -u ${IMAGE_OWNER} --password-stdin
                            docker tag ${SERVER_IMAGE}:${GIT_COMMIT} ${SERVER_IMAGE}:latest
                            docker tag ${CLIENT_IMAGE}:${GIT_COMMIT} ${CLIENT_IMAGE}:latest
                            docker push ${SERVER_IMAGE}:${GIT_COMMIT}
                            docker push ${SERVER_IMAGE}:latest
                            docker push ${CLIENT_IMAGE}:${GIT_COMMIT}
                            docker push ${CLIENT_IMAGE}:latest
                        '''
                    }
                }
            }
        }

        // CD: apply Kubernetes manifests and refresh runtime secrets.
        stage('Deploy to Kubernetes') {
            when {
                expression { env.BRANCH_NAME in ['main', 'master'] || env.GIT_BRANCH in ['main', 'master', 'origin/main', 'origin/master'] }
            }
            steps {
                withCredentials([
                    file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG_FILE'),
                    string(credentialsId: 'flonest-mongo-uri', variable: 'MONGO_URI'),
                    string(credentialsId: 'flonest-jwt-secret', variable: 'JWT_SECRET'),
                    string(credentialsId: 'flonest-email-host', variable: 'EMAIL_HOST'),
                    string(credentialsId: 'flonest-email-port', variable: 'EMAIL_PORT'),
                    string(credentialsId: 'flonest-email-user', variable: 'EMAIL_USER'),
                    string(credentialsId: 'flonest-email-pass', variable: 'EMAIL_PASS')
                ]) {
                    ws('flonest-clean') {
                        dir('flonest') {
                            sh '''
                                export KUBECONFIG="$KUBECONFIG_FILE"
                                kubectl create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
                                kubectl -n ${K8S_NAMESPACE} create secret generic flonest-secrets \
                                  --from-literal=MONGO_URI="$MONGO_URI" \
                                  --from-literal=JWT_SECRET="$JWT_SECRET" \
                                  --from-literal=EMAIL_HOST="$EMAIL_HOST" \
                                  --from-literal=EMAIL_PORT="$EMAIL_PORT" \
                                  --from-literal=EMAIL_USER="$EMAIL_USER" \
                                  --from-literal=EMAIL_PASS="$EMAIL_PASS" \
                                  --dry-run=client -o yaml | kubectl apply -f -
                                kubectl apply -k k8s/base
                                kubectl -n ${K8S_NAMESPACE} rollout status deployment/flonest-api --timeout=180s
                                kubectl -n ${K8S_NAMESPACE} rollout status deployment/flonest-web --timeout=180s
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.WORKSPACE) {
                    deleteDir()
                }
            }
        }
    }
}
